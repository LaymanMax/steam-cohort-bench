# Server configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Analytical data directories
DATA_DIR=./data
RAW_PARQUET_PATH=./data/raw/steam-games.parquet
PROCESSED_PARQUET_PATH=./data/processed/canonical_games.parquet
ANALYTICS_DB_PATH=./data/processed/analytics.duckdb
MANIFEST_PATH=./data/manifests/manifest.json

# Caching & performance
CACHE_TTL_SECONDS=600
MAX_CACHE_ITEMS=500

# Frontend static distribution path
STATIC_DIR=./web/dist
